text2mp3() {
    local opt optarg s

    # 引数を取る指定は - のみ
    while getopts viosd-: opt; do
        # OPTIND 番目の引数を optarg へ代入
        optarg="${!OPTIND}"
        [[ "$opt" = - ]] && opt="-$OPTARG"
        case "-$opt" in
            -v|--volumn)
                volumn="$optarg"
                shift
                ;;
            -i|--inputfile)
                inputfile="$optarg"
                shift
                ;;
            -o|--output)
                output="$optarg"
                shift
                ;;
            -s|--srt)
                srtfile="/tmp/volumn/$optarg"
                srtopt="-s $srtfile"
                shift
                ;;
            -d|--dict)
                dict="$optarg"
                shift
                ;;
            --)
                break
                ;;
            -\?)
                exit 1
                ;;
            --*)
                echo "$0: illegal option -- ${opt##-}" >&2
                exit 1
                ;;
        esac
    done
    shift $((OPTIND - 1))

    podman run \
        --rm -it \
        -v "$volumn":/tmp/volumn:Z \
        sabotagecla6/text2mp3 \
        /bin/bash /usr/local/text2mp3/text2mp3.sh \
        -i "/tmp/volumn/$inputfile" \
        -o "/tmp/volumn/$output" \
        -d "/tmp/volumn/$dict" \
        "$srtopt"
}

text2mp3 $@